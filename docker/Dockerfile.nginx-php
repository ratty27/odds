FROM rockylinux:9

# Update system and install git first (to avoid BuildKit warnings)
RUN dnf update -y && \
		dnf install -y git

# Install EPEL and Remi repositories for PHP 8.2
RUN dnf install -y epel-release && \
		dnf install -y https://rpms.remirepo.net/enterprise/remi-release-9.rpm && \
		dnf makecache

# Enable PHP 8.2 module
RUN dnf module reset php -y && \
		dnf module enable php:remi-8.2 -y

# Install system dependencies (nginx is available in EPEL or base repo)
# Use --allowerasing to replace curl-minimal with curl
RUN dnf install -y --allowerasing \
		curl \
		nginx \
		procps-ng \
		&& dnf clean all

# Install PHP and extensions
RUN dnf install -y \
		php \
		php-fpm \
		php-cli \
		php-common \
		php-pdo \
		php-mysqlnd \
		php-mbstring \
		php-xml \
		php-gd \
		php-zip \
		php-bcmath \
		php-process \
		&& dnf clean all

# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer


# Set working directory
WORKDIR /var/www/html

# Copy nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy PHP configuration
COPY docker/php.ini /etc/php.d/custom.ini

# Create PHP-FPM runtime directory
RUN mkdir -p /run/php-fpm && \
		chown nginx:nginx /run/php-fpm

# Modify default www.conf to use TCP port instead of Unix socket
RUN sed -i 's|^listen = .*|listen = 127.0.0.1:9000|' /etc/php-fpm.d/www.conf && \
		sed -i 's|^user = .*|user = nginx|' /etc/php-fpm.d/www.conf && \
		sed -i 's|^group = .*|group = nginx|' /etc/php-fpm.d/www.conf && \
		sed -i 's|^listen.owner = .*|listen.owner = nginx|' /etc/php-fpm.d/www.conf && \
		sed -i 's|^listen.group = .*|listen.group = nginx|' /etc/php-fpm.d/www.conf || true

# Copy application files from build context (project root)
COPY . /var/www/html/

# Set permissions
RUN chown -R nginx:nginx /var/www/html \
	&& chmod -R 755 /var/www/html/storage \
	&& chmod -R 755 /var/www/html/bootstrap/cache

# Expose ports
EXPOSE 80

# Start script
COPY docker/start.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/start.sh

# Set entrypoint
ENTRYPOINT []

CMD ["/usr/local/bin/start.sh"]
